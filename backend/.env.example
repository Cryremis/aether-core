# backend/.env.example
APP_NAME=AetherCore Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8100
APP_PUBLIC_BASE_URL=http://127.0.0.1:8100
APP_DEBUG=true
MANAGE_FRONTEND_PUBLIC_BASE_URL=http://127.0.0.1:5178
CORS_ORIGINS=["*"]

LLM_PROVIDER=openai_compatible
LLM_PROVIDER_NAME=volcengine
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=ep-20260214160206-k72dd
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=4000
LLM_SSL_VERIFY=true
HTTP_CLIENT_SSL_VERIFY=true
# models.dev 模型能力目录拉取：内网无法访问外网时置 false（走本地缓存/内置配置，避免请求被网络超时阻塞）
MODELS_FETCH_ENABLED=true
AGENT_MAX_TURNS=32
AGENT_MAX_RUNTIME_SECONDS=3600
AGENT_MAX_STALL_ROUNDS=5
HOST_TOOL_TIMEOUT_SECONDS=120

# Scheduled Agent tasks
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=5
SCHEDULER_WORKERS=4
SCHEDULER_LEASE_SECONDS=120
SCHEDULE_MAX_PER_OWNER=50
SCHEDULE_MIN_INTERVAL_SECONDS=60
AGENT_SCHEDULES_REQUIRE_APPROVAL=true

SANDBOX_EXECUTOR=docker
SANDBOX_FAIL_CLOSED=true
SANDBOX_LOCAL_ENABLED=false
SANDBOX_SHELL=bash
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
# SANDBOX_COMMAND_MAX_TIMEOUT_SECONDS=1800
SANDBOX_OUTPUT_CHAR_LIMIT=12000
SANDBOX_FILE_READ_LIMIT_BYTES=131072
SANDBOX_ALLOW_NETWORK=true
SANDBOX_DOCKER_IMAGE=aethercore-sandbox:latest
SANDBOX_DOCKER_NETWORK_MODE=bridge
SANDBOX_DOCKER_AUTO_DNS_FROM_HOST=true
SANDBOX_DOCKER_DNS_SERVERS=[]
SANDBOX_DOCKER_ENV_PASSTHROUGH=["HTTP_PROXY","HTTPS_PROXY","NO_PROXY","http_proxy","https_proxy","no_proxy","ALL_PROXY","all_proxy","PIP_INDEX_URL","PIP_EXTRA_INDEX_URL","PIP_TRUSTED_HOST"]
SANDBOX_DOCKER_MEMORY=1g
SANDBOX_DOCKER_CPUS=1.0
SANDBOX_DOCKER_PIDS_LIMIT=128
SANDBOX_DOCKER_READ_ONLY_ROOTFS=false
CAPABILITY_SECRET_ENCRYPTION_KEY=replace-with-a-long-random-production-key
